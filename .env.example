# Copy to .env in the repository root and fill in your own values.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# IP addresses for compatible Kasa SmartPlug devices on your local network.
IP_Address_right=
IP_Address_left=
IP_Address_LED1=
IP_Address_LED2=

# Hardware is optional. Empty ARDUINO_PORT disables servo output.
ARDUINO_PORT=
CAMERA_INDEX=0
ENABLE_SMART_LIGHTS=false
# Optional absolute path to a complete OpenSeeFace checkout.
# OPENSEEFACE_PATH=/path/to/OpenSeeFace
GEMINI_MODEL=gemini-3.1-flash-lite
ELEVENLABS_VOICE_ID=NNl6r8mD7vthiJatiJt1
ELEVENLABS_MODEL=eleven_flash_v2_5
